digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Tenant Resolver", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "U" [label="URL /{tenantSlug}/app"];
  "S" [label="S"];
  "V" [label="V"];
  "X" [label="404 / indisponível"];
  "T" [label="T"];
  "A" [label="A"];
  "M" [label="M"];
  "P" [label="P"];
  "F" [label="403 / acesso negado"];
  "C" [label="C"];
  "D" [label="Paths derivados do tenantId"];
  "U" -> "S";
  "S" -> "V";
  "V" -> "X" [label="não"];
  "V" -> "T" [label="sim"];
  "T" -> "A";
  "A" -> "M";
  "M" -> "P";
  "P" -> "F" [label="não"];
  "P" -> "C" [label="sim"];
  "C" -> "D";
}
