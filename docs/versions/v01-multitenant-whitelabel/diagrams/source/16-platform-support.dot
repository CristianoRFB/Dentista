digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Suporte clínico da plataforma", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "O" [label="Platform Owner autenticado"];
  "R" [label="R"];
  "J" [label="J"];
  "E" [label="E"];
  "A" [label="A"];
  "C" [label="C"];
  "X" [label="Revogar + audit log"];
  "Z" [label="Expiração automática encerra acesso"];
  "O" -> "R";
  "R" -> "J";
  "J" -> "E";
  "E" -> "A";
  "A" -> "C";
  "C" -> "X";
  "C" -> "Z";
}
