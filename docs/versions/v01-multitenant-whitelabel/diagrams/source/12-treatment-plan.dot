digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="FUTURO — modelo conceitual, plano de tratamento não implementado no runtime atual", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "N1" [label="Draft"];
  "N2" [label="Presented"];
  "N3" [label="Approved"];
  "N4" [label="Partially Approved"];
  "N5" [label="In Progress"];
  "N6" [label="Completed"];
  "N7" [label="Cancelled"];
  "N1" -> "N2";
  "N2" -> "N3";
  "N2" -> "N4";
  "N3" -> "N5";
  "N4" -> "N5";
  "N5" -> "N6";
  "N1" -> "N7";
}
