digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Sequência de criação", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "UI" [label="UI envia request"];
  "W" [label="W"];
  "T" [label="T"];
  "Q" [label="Q"];
  "K" [label="K"];
  "V" [label="V"];
  "C" [label="Commit: appointment + locks + audit"];
  "X" [label="Rollback e HTTP 409"];
  "UI" -> "W";
  "W" -> "T";
  "T" -> "Q";
  "Q" -> "K";
  "K" -> "V";
  "V" -> "C" [label="livre"];
  "V" -> "X" [label="conflito"];
}
