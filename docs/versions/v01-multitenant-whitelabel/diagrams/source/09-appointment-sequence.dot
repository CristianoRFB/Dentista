digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.7", label="Sequência de criação", labelloc=t, fontsize=20, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", color="#94a3b8", fontname="Arial", fontsize=11, margin="0.16,0.10"];
  edge [color="#64748b", arrowsize=0.7, fontname="Arial"];
  "UI";
  "Appointment Service";
  "Firestore Query";
  "Conflict Validator";
  "Transaction";
  "Appointment";
