%% Tenant Resolver
flowchart LR
  U["URL /{tenantSlug}/app"] --> S["Ler tenantSlugs/{slug}"]
  S --> V{Slug existe e ativo?}
  V -- não --> X["404 / indisponível"]
  V -- sim --> T["Ler tenantId + tenant ativo"]
  T --> A["Firebase Auth UID"]
  A --> M["Ler memberships/{uid}"]
  M --> P{Membership ativa?}
  P -- não --> F["403 / acesso negado"]
  P -- sim --> C["TenantContext + permissions"]
  C --> D["Paths derivados do tenantId"]
