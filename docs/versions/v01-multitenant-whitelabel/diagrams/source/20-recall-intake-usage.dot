digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="FUTURO — intake público e retorno persistido não estão ativos; usage comercial é scaffold", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "P" [label="Paciente"];
  "I" [label="I"];
  "R" [label="R"];
  "PR" [label="PR"];
  "V" [label="V"];
  "RC" [label="RC"];
  "A" [label="A"];
  "U" [label="UsageCounter"];
  "P" -> "I";
  "I" -> "R";
  "R" -> "PR";
  "PR" -> "V";
  "V" -> "RC";
  "RC" -> "A";
  "A" -> "U" [label="se houver integração paga", style=dashed];
}
