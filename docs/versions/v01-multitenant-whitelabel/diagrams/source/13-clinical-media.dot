digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Mídia clínica", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "U" [label="Upload autenticado"];
  "W" [label="W"];
  "A" [label="A"];
  "P" [label="P"];
  "F" [label="F"];
  "R2" [label="R2"];
  "M" [label="M"];
  "D" [label="D"];
  "H" [label="Cache-Control private, no-store"];
  "U" -> "W";
  "W" -> "A";
  "A" -> "P";
  "P" -> "F";
  "F" -> "R2";
  "R2" -> "M";
  "M" -> "D";
  "D" -> "H";
}
