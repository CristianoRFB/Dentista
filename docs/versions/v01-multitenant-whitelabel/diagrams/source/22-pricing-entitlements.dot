digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="22-pricing-entitlements", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "P" [label="Pricing proposal\n(PROPOSTA)"];
  "C" [label="C"];
  "S" [label="S"];
  "E" [label="E"];
  "UI" [label="UI gates"];
  "BE" [label="Backend / Worker gates"];
  "L" [label="L"];
  "U" [label="Usage counters"];
  "D" [label="Demo tenant\npremium_demo"];
  "P" -> "C";
  "C" -> "S";
  "S" -> "E";
  "E" -> "UI";
  "E" -> "BE";
  "E" -> "L";
  "L" -> "U" [style=dashed];
  "D" -> "E" [style=dashed];
}
