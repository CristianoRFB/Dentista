digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="ERD principal", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "T" [label="T"];
  "M" [label="memberships/{uid}"];
  "P" [label="professionals"];
  "PT" [label="PT"];
  "PR" [label="procedures"];
  "SR" [label="scheduleResources"];
  "A" [label="appointments"];
  "B" [label="scheduleBlocks + scheduleLocks"];
  "CR" [label="CR"];
  "AM" [label="clinicalRecordAmendments"];
  "PH" [label="PH"];
  "R2" [label="R2 privado: bytes"];
  "AU" [label="auditLogs"];
  "PP" [label="publicProfile seguro"];
  "F" [label="Odontogram / TreatmentPlan — futuro"];
  "T" -> "M";
  "T" -> "P";
  "T" -> "PT";
  "T" -> "PR";
  "T" -> "SR";
  "T" -> "A";
  "T" -> "B";
  "PT" -> "CR";
  "CR" -> "AM";
  "PT" -> "PH";
  "PH" -> "R2";
  "T" -> "AU";
  "T" -> "PP";
  "F" -> "T";
}
