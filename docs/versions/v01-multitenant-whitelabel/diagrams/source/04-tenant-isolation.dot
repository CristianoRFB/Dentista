digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Isolamento Multi-Tenant", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "U" [label="Usuário autenticado"];
  "M" [label="M"];
  "S" [label="S"];
  "L" [label="L"];
  "T" [label="T"];
  "A" [label="A"];
  "B" [label="B"];
  "R" [label="R"];
  "X" [label="Acesso negado se tenant divergir"];
  "P" [label="publicProfile seguro"];
  "U" -> "M";
  "S" -> "L";
  "L" -> "T";
  "M" -> "T";
  "T" -> "A";
  "T" -> "B";
  "A" -> "R";
  "B" -> "R";
  "R" -> "X";
  "P" -> "S";
}
