digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Domínio clínico", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "P" [label="P"];
  "R" [label="R"];
  "A" [label="ClinicalRecordAmendment"];
  "M" [label="M"];
  "W" [label="W"];
  "R2" [label="R2 privado"];
  "L" [label="AuditLog sem conteúdo clínico"];
  "F" [label="Odontogram / TreatmentPlan — futuro"];
  "P" -> "R";
  "R" -> "A";
  "P" -> "M";
  "M" -> "W";
  "W" -> "R2";
  "R" -> "L";
  "P" -> "F";
}
