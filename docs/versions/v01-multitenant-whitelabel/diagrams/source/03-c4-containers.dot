digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="C4 Containers", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "B" [label="B"];
  "A" [label="Firebase Auth"];
  "R" [label="R"];
  "W" [label="W"];
  "J" [label="Firebase ID token / JWKS"];
  "F" [label="Firestore REST + transações"];
  "O" [label="R2 privado"];
  "S" [label="tenantSlugs + tenants + memberships"];
  "B" -> "A";
  "B" -> "R";
  "B" -> "W";
  "W" -> "J";
  "W" -> "F";
  "W" -> "O";
  "R" -> "S";
}
