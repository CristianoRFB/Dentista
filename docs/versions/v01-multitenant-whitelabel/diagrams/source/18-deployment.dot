digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Deployment", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "G" [label="GitHub: um repositório"];
  "P" [label="P"];
  "A" [label="Firebase Auth"];
  "F" [label="F"];
  "W" [label="W"];
  "R2" [label="R2 privado"];
  "E" [label="Firebase Emulator local"];
  "D" [label="Desenvolvimento e Rules tests"];
  "G" -> "P";
  "P" -> "A";
  "P" -> "F";
  "P" -> "W";
  "W" -> "F";
  "W" -> "R2";
  "E" -> "D";
}
