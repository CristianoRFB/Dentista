digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="Fluxo de agendamento", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "UI" [label="React: criar / remarcar"];
  "W" [label="W"];
  "A" [label="A"];
  "R" [label="R"];
  "B" [label="B"];
  "C" [label="C"];
  "L" [label="L"];
  "D" [label="D"];
  "X" [label="409: horário indisponível"];
  "S" [label="Gravar appointment + audit log"];
  "UI" -> "W";
  "W" -> "A";
  "A" -> "R";
  "R" -> "B";
  "B" -> "C";
  "C" -> "L";
  "L" -> "D";
  "D" -> "X" [label="sim"];
  "D" -> "S" [label="não"];
}
