digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="C4 Context", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "O" [label="Platform Owner"];
  "S" [label="S"];
  "D" [label="Dono / admin da clínica"];
  "P" [label="P"];
  "R" [label="Recepção"];
  "F" [label="Firebase Auth + Firestore Rules"];
  "W" [label="W"];
  "R2" [label="R2 privado"];
  "N" [label="Paciente fictício de teste"];
  "O" -> "S";
  "D" -> "S";
  "P" -> "S";
  "R" -> "S";
  "S" -> "F";
  "S" -> "W";
  "W" -> "R2";
  "P" -> "N";
}
