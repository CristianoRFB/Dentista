digraph G {
  rankdir=TB;
  graph [bgcolor="white", pad="0.3", label="21-schedule-resource-conflict", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "A" [label="Request autenticada"];
  "B" [label="B"];
  "X" [label="X"];
  "C" [label="C"];
  "D" [label="D"];
  "E" [label="E"];
  "F" [label="F"];
  "T" [label="T"];
  "OK" [label="Confirmar"];
  "A" -> "B";
  "B" -> "X" [label="não"];
  "B" -> "C" [label="sim"];
  "C" -> "D";
  "D" -> "E";
  "E" -> "F";
  "F" -> "X" [label="sim"];
  "F" -> "T" [label="não"];
  "T" -> "OK";
}
