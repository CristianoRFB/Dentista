digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad="0.3", label="FUTURO — modelo conceitual, odontograma não implementado no runtime atual", labelloc=t, fontsize=18, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f6faf9", color="#8aa9a3", fontname="Arial", fontsize=11];
  edge [color="#5f7b76", fontname="Arial", fontsize=9];
  "N1" [label="Tooth/Region"];
  "N2" [label="Event 1"];
  "N3" [label="Event 2"];
  "N4" [label="Event 3"];
  "N5" [label="Derived Current State"];
  "N6" [label="Historical Timeline"];
  "N1" -> "N2";
  "N2" -> "N3";
  "N3" -> "N4";
  "N4" -> "N5";
  "N5" -> "N6";
}
