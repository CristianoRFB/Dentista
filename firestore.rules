rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function platformOwnerPath() {
      return /databases/$(database)/documents/platformOwners/$(request.auth.uid);
    }

    function isPlatformOwner() {
      return signedIn()
        && exists(platformOwnerPath())
        && get(platformOwnerPath()).data.status == 'active';
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function tenantPatientPath(tenantId, patientId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/patients/$(patientId);
    }

    function patientBelongsToTenant(tenantId, patientId) {
      return exists(tenantPatientPath(tenantId, patientId))
        && get(tenantPatientPath(tenantId, patientId)).data.tenantId == tenantId;
    }

    function membershipPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid);
    }

    function hasMembership(tenantId) {
      return signedIn()
        && exists(membershipPath(tenantId))
        && get(membershipPath(tenantId)).data.tenantId == tenantId
        && get(membershipPath(tenantId)).data.userId == request.auth.uid
        && get(membershipPath(tenantId)).data.status == 'active';
    }

    function activeTenant(tenantId) {
      return exists(tenantPath(tenantId))
        && get(tenantPath(tenantId)).data.id == tenantId
        && get(tenantPath(tenantId)).data.status == 'active';
    }

    function hasPermission(tenantId, permission) {
      return hasMembership(tenantId)
        && activeTenant(tenantId)
        && permission in get(membershipPath(tenantId)).data.permissions;
    }

    function isPremiumDemoTenant(tenantId) {
      return exists(tenantPath(tenantId))
        && (get(tenantPath(tenantId)).data.get('planId', null) == 'premium_demo'
          || get(tenantPath(tenantId)).data.get('subscriptionStatus', null) == 'demo');
    }

    function commercialStatusAllows(tenant) {
      let status = tenant.get('subscriptionStatus', null);
      let planId = tenant.get('planId', null);
      return (status == 'active' && planId in ['essential','pro','premium'])
        || (status == 'trial' && planId in ['essential','pro','premium']
          && tenant.get('trialUntil', null) is timestamp && tenant.trialUntil > request.time)
        || (status == 'demo' && planId == 'premium_demo');
    }

    function featureImplemented(featureKey) {
      return featureKey in [
        'agenda','patients','professionals','procedures','physical_resources',
        'clinical_records','clinical_photos','mini_site'
      ];
    }

    function hasCommercialFeature(tenantId, featureKey, minimumPlan) {
      let tenant = get(tenantPath(tenantId)).data;
      let overrides = tenant.get('entitlementOverrides', {});
      let override = overrides.get(featureKey, null);
      let planId = tenant.get('planId', null);
      let planRank = planId == 'essential' ? 1 : (planId == 'pro' ? 2 : (planId in ['premium','premium_demo'] ? 3 : 0));
      let minimumRank = minimumPlan == 'essential' ? 1 : (minimumPlan == 'pro' ? 2 : 3);
      return activeTenant(tenantId)
        && commercialStatusAllows(tenant)
        && featureImplemented(featureKey)
        && tenant.get('features', {}).get(featureKey, true) == true
        && (override == true || (override != false && planRank >= minimumRank));
    }

    function hasRolePermission(role, permission) {
      return (role == 'tenant_owner' && permission in [
          'tenant.manage','memberships.read','memberships.manage','professionals.read','professionals.manage',
          'patients.read','patients.manage','appointments.read','appointments.manage','resources.read','resources.manage',
          'recalls.read','recalls.manage','intake.read','intake.manage','procedures.read','procedures.manage',
          'billing.read','billing.write','usage.read','audit.read'
        ])
        || (role == 'tenant_admin' && permission in [
          'memberships.read','professionals.read','professionals.manage','patients.read','patients.manage',
          'appointments.read','appointments.manage','resources.read','resources.manage','recalls.read','recalls.manage',
          'intake.read','intake.manage','procedures.read','procedures.manage','billing.read','billing.write'
        ])
        || (role == 'dentist' && permission in [
          'professionals.read','patients.read','appointments.read','appointments.manage','procedures.read',
          'clinical.read','clinical.write','treatment.read','treatment.write','recalls.read','recalls.manage','resources.read'
        ])
        || (role == 'receptionist' && permission in [
          'professionals.read','patients.read','patients.manage','appointments.read','appointments.manage',
          'procedures.read','resources.read','recalls.read','recalls.manage','intake.read','intake.manage','billing.read','billing.write'
        ])
        || (role == 'assistant' && permission in [
          'professionals.read','patients.read','appointments.read','procedures.read','resources.read'
        ]);
    }

    function validMembershipData(tenantId, uid, data) {
      return data.keys().hasOnly(['userId','tenantId','role','status','permissions','createdAt','createdBy','lastAuditLogId','updatedAt'])
        && data.tenantId == tenantId
        && data.userId == uid
        && data.role in ['tenant_owner','tenant_admin','dentist','receptionist','assistant']
        && data.status in ['active','inactive']
        && data.permissions is list
        && data.permissions.size() <= 24
        && data.permissions.hasOnly([
          'tenant.manage','memberships.read','memberships.manage','professionals.read','professionals.manage',
          'patients.read','patients.manage','appointments.read','appointments.manage','resources.read','resources.manage',
          'recalls.read','recalls.manage','intake.read','intake.manage','procedures.read','procedures.manage',
          'billing.read','billing.write','usage.read','audit.read','clinical.read','clinical.write',
          'treatment.read','treatment.write'
        ])
        && (data.role == 'tenant_owner' || data.permissions.hasOnly([
          'memberships.read','professionals.read','professionals.manage','patients.read','patients.manage',
          'appointments.read','appointments.manage','resources.read','resources.manage','recalls.read','recalls.manage',
          'intake.read','intake.manage','procedures.read','procedures.manage','billing.read','billing.write',
          'clinical.read','clinical.write','treatment.read','treatment.write','tenant.manage','memberships.manage',
          'usage.read','audit.read'
        ]))
        && data.permissions.hasOnly(rolePermissions(data.role));
    }

    function rolePermissions(role) {
      return role == 'tenant_owner' ? [
        'tenant.manage','memberships.read','memberships.manage','professionals.read','professionals.manage',
        'patients.read','patients.manage','appointments.read','appointments.manage','resources.read','resources.manage',
        'recalls.read','recalls.manage','intake.read','intake.manage','procedures.read','procedures.manage',
        'billing.read','billing.write','usage.read','audit.read'
      ] : role == 'tenant_admin' ? [
        'memberships.read','professionals.read','professionals.manage','patients.read','patients.manage',
        'appointments.read','appointments.manage','resources.read','resources.manage','recalls.read','recalls.manage',
        'intake.read','intake.manage','procedures.read','procedures.manage','billing.read','billing.write'
      ] : role == 'dentist' ? [
        'professionals.read','patients.read','appointments.read','appointments.manage','procedures.read',
        'clinical.read','clinical.write','treatment.read','treatment.write','recalls.read','recalls.manage','resources.read'
      ] : role == 'receptionist' ? [
        'professionals.read','patients.read','patients.manage','appointments.read','appointments.manage',
        'procedures.read','resources.read','recalls.read','recalls.manage','intake.read','intake.manage','billing.read','billing.write'
      ] : [
        'professionals.read','patients.read','appointments.read','procedures.read','resources.read'
      ];
    }

    function supportPath(tenantId) {
      return /databases/$(database)/documents/platformSupportAccess/$(tenantId);
    }

    function hasActiveClinicalSupport(tenantId) {
      return isPlatformOwner()
        && activeTenant(tenantId)
        && exists(supportPath(tenantId))
        && get(supportPath(tenantId)).data.tenantId == tenantId
        && get(supportPath(tenantId)).data.actorId == request.auth.uid
        && get(supportPath(tenantId)).data.reason is string
        && get(supportPath(tenantId)).data.reason.size() >= 12
        && get(supportPath(tenantId)).data.expiresAt is timestamp
        && get(supportPath(tenantId)).data.expiresAt > request.time
        && (!('revokedAt' in get(supportPath(tenantId)).data) || get(supportPath(tenantId)).data.revokedAt == null);
    }

    function clinicalRead(tenantId) {
      return hasPermission(tenantId, 'clinical.read') || hasActiveClinicalSupport(tenantId);
    }

    function clinicalWrite(tenantId) {
      return hasPermission(tenantId, 'clinical.write') || hasActiveClinicalSupport(tenantId);
    }

    function tenantAuditPath(tenantId, auditId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/auditLogs/$(auditId);
    }

    function auditAfterMatches(tenantId, auditId, action, resourceType, resourceId) {
      return auditId is string
        && existsAfter(tenantAuditPath(tenantId, auditId))
        && getAfter(tenantAuditPath(tenantId, auditId)).data.tenantId == tenantId
        && getAfter(tenantAuditPath(tenantId, auditId)).data.actorId == request.auth.uid
        && getAfter(tenantAuditPath(tenantId, auditId)).data.action == action
        && getAfter(tenantAuditPath(tenantId, auditId)).data.resourceType == resourceType
        && getAfter(tenantAuditPath(tenantId, auditId)).data.resourceId == resourceId
        && getAfter(tenantAuditPath(tenantId, auditId)).data.timestamp == request.time;
    }

    function commercialSnapshotMatches(snapshot, tenantData) {
      return snapshot is map
        && snapshot.keys().hasOnly(['planId','subscriptionStatus','trialUntil','entitlementOverrides','limitOverrides'])
        && snapshot.get('planId', null) == tenantData.get('planId', null)
        && snapshot.get('subscriptionStatus', null) == tenantData.get('subscriptionStatus', null)
        && snapshot.get('trialUntil', null) == tenantData.get('trialUntil', null)
        && snapshot.get('entitlementOverrides', {}) == tenantData.get('entitlementOverrides', {})
        && snapshot.get('limitOverrides', {}) == tenantData.get('limitOverrides', {});
    }

    function validEntitlementOverrides(overrides) {
      return overrides is map
        && overrides.keys().hasOnly([
          'agenda','patients','professionals','procedures','physical_resources','clinical_records','clinical_photos',
          'recall_center','mini_site','intake_link','treatment_plans','financial_reports','advanced_reports',
          'patient_portal','automations','multi_unit'
        ])
        && (!('agenda' in overrides) || overrides.agenda is bool)
        && (!('patients' in overrides) || overrides.patients is bool)
        && (!('professionals' in overrides) || overrides.professionals is bool)
        && (!('procedures' in overrides) || overrides.procedures is bool)
        && (!('physical_resources' in overrides) || overrides.physical_resources is bool)
        && (!('clinical_records' in overrides) || overrides.clinical_records is bool)
        && (!('clinical_photos' in overrides) || overrides.clinical_photos is bool)
        && (!('recall_center' in overrides) || overrides.recall_center is bool)
        && (!('mini_site' in overrides) || overrides.mini_site is bool)
        && (!('intake_link' in overrides) || overrides.intake_link is bool)
        && (!('treatment_plans' in overrides) || overrides.treatment_plans is bool)
        && (!('financial_reports' in overrides) || overrides.financial_reports is bool)
        && (!('advanced_reports' in overrides) || overrides.advanced_reports is bool)
        && (!('patient_portal' in overrides) || overrides.patient_portal is bool)
        && (!('automations' in overrides) || overrides.automations is bool)
        && (!('multi_unit' in overrides) || overrides.multi_unit is bool);
    }

    function validCommercialState(data) {
      let entitlementOverrides = data.get('entitlementOverrides', {});
      let limitOverrides = data.get('limitOverrides', {});
      return data.planId in ['essential','pro','premium']
        && data.subscriptionStatus in ['trial','active','past_due','suspended','cancelled']
        && ((data.subscriptionStatus == 'trial' && data.trialUntil is timestamp && data.trialUntil > request.time
            && data.trialUntil <= request.time + duration.value(14, 'd'))
          || (data.subscriptionStatus != 'trial' && data.get('trialUntil', null) == null))
        && validEntitlementOverrides(entitlementOverrides)
        && limitOverrides is map
        && limitOverrides.keys().hasOnly(['professionals','adminUsers','resources','units','patients','appointments','clinicalHistory'])
        && (!('professionals' in limitOverrides) || limitOverrides.professionals == null || (limitOverrides.professionals is int && limitOverrides.professionals >= 0))
        && (!('adminUsers' in limitOverrides) || limitOverrides.adminUsers == null || (limitOverrides.adminUsers is int && limitOverrides.adminUsers >= 0))
        && (!('resources' in limitOverrides) || limitOverrides.resources == null || (limitOverrides.resources is int && limitOverrides.resources >= 0))
        && (!('units' in limitOverrides) || limitOverrides.units == null || (limitOverrides.units is int && limitOverrides.units >= 0))
        && (!('patients' in limitOverrides) || limitOverrides.patients == null || (limitOverrides.patients is int && limitOverrides.patients >= 0))
        && (!('appointments' in limitOverrides) || limitOverrides.appointments == null || (limitOverrides.appointments is int && limitOverrides.appointments >= 0))
        && (!('clinicalHistory' in limitOverrides) || limitOverrides.clinicalHistory == null || (limitOverrides.clinicalHistory is int && limitOverrides.clinicalHistory >= 0));
    }

    function commercialAuditValid(data, tenantId, creating) {
      let beforeData = data.before;
      let afterData = data.after;
      return data.reason is string && data.reason.size() >= 12 && data.reason.size() <= 400
        && commercialSnapshotMatches(afterData, getAfter(tenantPath(tenantId)).data)
        && validCommercialState(afterData)
        && (creating
          ? beforeData == {'planId':null,'subscriptionStatus':null,'trialUntil':null,'entitlementOverrides':{},'limitOverrides':{}}
          : exists(tenantPath(tenantId))
            && commercialSnapshotMatches(beforeData, get(tenantPath(tenantId)).data));
    }

    function tenantUpdateAuditValid(tenantId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let commercialKeys = ['planId','subscriptionStatus','trialUntil','entitlementOverrides','limitOverrides'];
      return changedKeys.hasAny(commercialKeys)
        ? (isPlatformOwner()
          ? changedKeys.hasOnly(['planId','subscriptionStatus','trialUntil','entitlementOverrides','limitOverrides','lastAuditLogId','updatedAt'])
            && validCommercialState(request.resource.data)
            && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'tenant.commercial.update', 'tenant', tenantId)
          : false)
        : (isPlatformOwner()
          ? auditAfterMatches(tenantId, request.resource.data.lastAuditLogId,
            request.resource.data.status != resource.data.status
              ? (request.resource.data.status == 'suspended' ? 'tenant.suspend' : 'tenant.activate')
              : 'tenant.branding.update', 'tenant', tenantId)
          : (hasPermission(tenantId, 'tenant.manage') && !changedKeys.hasAny(['status'])
            ? auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'tenant.branding.update', 'tenant', tenantId)
            : false));
    }

    function tenantAuditMutationMatches(tenantId, auditId, data) {
      let path = tenantPath(tenantId);
      return existsAfter(path)
        && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'tenant.create'
          ? !exists(path) && commercialAuditValid(data, tenantId, true)
          : data.action == 'tenant.commercial.update'
            ? exists(path) && get(path).data.lastAuditLogId != auditId && commercialAuditValid(data, tenantId, false)
            : data.action == 'tenant.activate'
              ? exists(path) && get(path).data.lastAuditLogId != auditId && getAfter(path).data.status == 'active'
              : data.action == 'tenant.suspend'
                ? exists(path) && get(path).data.lastAuditLogId != auditId && getAfter(path).data.status == 'suspended'
                : data.action == 'tenant.branding.update'
                  ? exists(path) && get(path).data.lastAuditLogId != auditId
                  : false);
    }

    function membershipAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/memberships/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'membership.create' ? !exists(path)
          : data.action == 'membership.update' ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function patientAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/patients/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'patient.create' ? !exists(path)
          : data.action in ['patient.update','patient.deactivate'] ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function professionalAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/professionals/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'professional.create' ? !exists(path)
          : data.action in ['professional.update','professional.activate','professional.deactivate'] ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function procedureAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/procedures/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'procedure.create' ? !exists(path)
          : data.action in ['procedure.update','procedure.deactivate'] ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function scheduleResourceAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/scheduleResources/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'resource.create' ? !exists(path)
          : data.action in ['resource.update','resource.activate','resource.deactivate'] ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function clinicalRecordAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/patients/$(data.patientId)/clinicalRecords/$(resourceId);
      return data.action == 'clinical_record.create'
        && existsAfter(path) && getAfter(path).data.auditLogId == auditId && !exists(path);
    }

    function clinicalAmendmentAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/patients/$(data.patientId)/clinicalRecordAmendments/$(resourceId);
      return data.action == 'clinical_amendment.create'
        && existsAfter(path) && getAfter(path).data.auditLogId == auditId && !exists(path);
    }

    function publicProfileAuditMutationMatches(tenantId, auditId, resourceId, data) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/publicProfile/$(resourceId);
      return existsAfter(path) && getAfter(path).data.lastAuditLogId == auditId
        && (data.action == 'publicProfile.create' ? !exists(path)
          : data.action == 'publicProfile.update' ? exists(path) && get(path).data.lastAuditLogId != auditId
          : false);
    }

    function supportAccessAuditMutationMatches(tenantId, auditId, resourceId) {
      return resourceId == tenantId && existsAfter(supportPath(tenantId))
        && getAfter(supportPath(tenantId)).data.auditLogId == auditId;
    }

    function auditMutationMatches(tenantId, auditId, data) {
      let resourceId = data.resourceId;
      return data.resourceType == 'tenant' ? tenantAuditMutationMatches(tenantId, auditId, data)
        : data.resourceType == 'membership' ? membershipAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'patient' ? patientAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'professional' ? professionalAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'procedure' ? procedureAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'scheduleResource' ? scheduleResourceAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'clinicalRecord' ? clinicalRecordAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'clinicalAmendment' ? clinicalAmendmentAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'publicProfile' ? publicProfileAuditMutationMatches(tenantId, auditId, resourceId, data)
        : data.resourceType == 'supportAccess' ? supportAccessAuditMutationMatches(tenantId, auditId, resourceId)
        : false;
    }

    function auditEnvelopeValid(tenantId, auditId, data) {
      return signedIn()
        && !isPremiumDemoTenant(tenantId)
        && data.keys().hasOnly(['tenantId','actorId','actorRole','action','resourceType','resourceId','timestamp','patientId','reason','before','after'])
        && data.tenantId == tenantId
        && data.actorId == request.auth.uid
        && data.actorRole is string
        && data.action is string
        && data.resourceType is string
        && data.resourceId is string
        && data.timestamp == request.time
        && ((data.actorRole == 'platform_owner' && isPlatformOwner())
          || (hasMembership(tenantId) && data.actorRole == get(membershipPath(tenantId)).data.role))
        && ((data.action in ['tenant.create','tenant.commercial.update'] && data.resourceType == 'tenant'
            && 'reason' in data && 'before' in data && 'after' in data)
          || (!('reason' in data) && !('before' in data) && !('after' in data)))
        && auditMutationMatches(tenantId, auditId, data);
    }

    function publicProfileValid(data, tenantId) {
      return data.tenantId == tenantId
        && data.keys().hasOnly([
          'tenantId','publicName','tagline','description','phone','email','address','primaryColor',
          'accentColor','logoUrl','lastAuditLogId','updatedAt'
        ])
        && data.publicName is string && data.publicName.size() <= 160
        && data.tagline is string && data.tagline.size() <= 240
        && data.description is string && data.description.size() <= 1000
        && data.phone is string && data.phone.size() <= 40
        && data.email is string && data.email.size() <= 254
        && data.address is string && data.address.size() <= 300
        && data.primaryColor is string && data.primaryColor.matches('^#[0-9A-Fa-f]{6}$')
        && data.accentColor is string && data.accentColor.matches('^#[0-9A-Fa-f]{6}$')
        && data.logoUrl is string && data.logoUrl.size() <= 500;
    }

    match /platformOwners/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformOwner());
      allow list: if isPlatformOwner();
      // Bootstrap and revocation happen through trusted Firebase administration.
      allow create, update, delete: if false;
    }

    match /platformSupportAccess/{tenantId} {
      allow get, list: if isPlatformOwner();
      allow create: if isPlatformOwner()
        && activeTenant(tenantId)
        && request.resource.data.tenantId == tenantId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 12
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'h')
        && request.resource.data.auditLogId is string
        && auditAfterMatches(tenantId, request.resource.data.auditLogId, 'support_access.grant', 'supportAccess', tenantId);
      allow update: if isPlatformOwner()
        && activeTenant(tenantId)
        && request.resource.data.tenantId == tenantId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 12
        && request.resource.data.auditLogId is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actorId','reason','expiresAt','auditLogId','createdAt','revokedAt'])
        && ((request.resource.data.revokedAt == request.time
            && auditAfterMatches(tenantId, request.resource.data.auditLogId, 'support_access.revoke', 'supportAccess', tenantId))
          || (request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time
            && request.resource.data.expiresAt <= request.time + duration.value(8, 'h')
            && auditAfterMatches(tenantId, request.resource.data.auditLogId, 'support_access.renew', 'supportAccess', tenantId)));
      allow delete: if false;
    }

    match /tenantSlugs/{slug} {
      allow get, list: if true;
      allow create: if isPlatformOwner()
        && request.resource.data.slug == slug
        && request.resource.data.tenantId is string
        && request.resource.data.status == 'active'
        && existsAfter(tenantPath(request.resource.data.tenantId))
        && getAfter(tenantPath(request.resource.data.tenantId)).data.slug == slug
        && auditAfterMatches(request.resource.data.tenantId, request.resource.data.auditLogId, 'tenant.create', 'tenant', request.resource.data.tenantId);
      allow update: if isPlatformOwner()
        && request.resource.data.slug == slug
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.status in ['active','suspended']
        && request.resource.data.status != resource.data.status
        && request.resource.data.auditLogId is string
        && request.resource.data.auditLogId != resource.data.auditLogId
        && auditAfterMatches(request.resource.data.tenantId, request.resource.data.auditLogId,
          request.resource.data.status == 'suspended' ? 'tenant.suspend' : 'tenant.activate', 'tenant', request.resource.data.tenantId);
      allow delete: if false;
    }

      match /tenants/{tenantId} {
      allow get: if isPlatformOwner() || hasMembership(tenantId);
      allow list: if isPlatformOwner();
      allow create: if isPlatformOwner()
        && request.resource.data.id == tenantId
        && request.resource.data.slug is string
        && request.resource.data.status == 'active'
        && request.resource.data.features is map
        && request.resource.data.limits is map
        && validCommercialState(request.resource.data)
        && request.resource.data.lastAuditLogId is string
        && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'tenant.create', 'tenant', tenantId);
      allow update: if !isPremiumDemoTenant(tenantId)
        && (isPlatformOwner() || hasPermission(tenantId, 'tenant.manage'))
        && request.resource.data.id == tenantId
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.status in ['active','suspended','archived']
        && request.resource.data.lastAuditLogId is string
        && request.resource.data.lastAuditLogId != resource.data.lastAuditLogId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','branding','features','limits','lastAuditLogId','updatedAt','planId','subscriptionStatus','trialUntil','entitlementOverrides','limitOverrides'])
        && tenantUpdateAuditValid(tenantId);
      allow delete: if false;

      match /publicProfile/{profileId} {
        allow get, list: if profileId == 'public' && hasCommercialFeature(tenantId, 'mini_site', 'essential');
        allow create: if profileId == 'public'
          && !isPremiumDemoTenant(tenantId)
          && publicProfileValid(request.resource.data, tenantId)
          && request.resource.data.lastAuditLogId is string
          && (isPlatformOwner() || hasPermission(tenantId, 'tenant.manage'))
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'publicProfile.create', 'publicProfile', profileId);
        allow update: if profileId == 'public'
          && !isPremiumDemoTenant(tenantId)
          && publicProfileValid(request.resource.data, tenantId)
          && request.resource.data.lastAuditLogId is string
          && request.resource.data.lastAuditLogId != resource.data.lastAuditLogId
          && (isPlatformOwner() || hasPermission(tenantId, 'tenant.manage'))
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'publicProfile.update', 'publicProfile', profileId);
        allow delete: if false;
      }

      match /memberships/{uid} {
        allow get: if isPlatformOwner()
          || (signedIn() && request.auth.uid == uid)
          || hasPermission(tenantId, 'memberships.read');
        allow list: if isPlatformOwner() || hasPermission(tenantId, 'memberships.read');
        allow create: if isPlatformOwner() && !exists(tenantPath(tenantId)) && existsAfter(tenantPath(tenantId))
          && signedIn() && request.auth.uid != uid
          && validMembershipData(tenantId, uid, request.resource.data)
          && request.resource.data.lastAuditLogId is string
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'membership.create', 'membership', uid);
        allow update: if false;
        allow delete: if false;
      }

      match /professionals/{professionalId} {
        allow get, list: if hasPermission(tenantId, 'professionals.read');
        allow create, update: if false;
        allow delete: if false;
      }

      match /procedures/{procedureId} {
        allow get, list: if hasPermission(tenantId, 'procedures.read');
        allow create: if !isPremiumDemoTenant(tenantId) && hasPermission(tenantId, 'procedures.manage')
          && request.resource.data.tenantId == tenantId
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes >= 5 && request.resource.data.durationMinutes <= 480
          && request.resource.data.active == true
          && request.resource.data.createdBy == request.auth.uid
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'procedure.create', 'procedure', procedureId);
        allow update: if !isPremiumDemoTenant(tenantId) && hasPermission(tenantId, 'procedures.manage')
          && request.resource.data.tenantId == tenantId
          && request.resource.data.name is string
          && request.resource.data.durationMinutes is int
          && request.resource.data.durationMinutes >= 5 && request.resource.data.durationMinutes <= 480
          && request.resource.data.lastAuditLogId != resource.data.lastAuditLogId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','durationMinutes','defaultPriceCents','active','lastAuditLogId','updatedAt'])
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId,
            request.resource.data.active == false ? 'procedure.deactivate' : 'procedure.update', 'procedure', procedureId);
        allow delete: if false;
      }

      match /patients/{patientId} {
        allow get, list: if hasPermission(tenantId, 'patients.read') || clinicalRead(tenantId);
        allow create: if !isPremiumDemoTenant(tenantId) && hasPermission(tenantId, 'patients.manage')
          && request.resource.data.tenantId == tenantId
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
          && request.resource.data.searchName is string
          && request.resource.data.status == 'active'
          && request.resource.data.createdBy == request.auth.uid
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId, 'patient.create', 'patient', patientId);
        allow update: if !isPremiumDemoTenant(tenantId) && hasPermission(tenantId, 'patients.manage')
          && request.resource.data.tenantId == tenantId
          && request.resource.data.name is string && request.resource.data.name.size() > 0
          && request.resource.data.status in ['active','inactive']
          && request.resource.data.lastAuditLogId != resource.data.lastAuditLogId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','email','searchName','status','lastAuditLogId','updatedAt'])
          && auditAfterMatches(tenantId, request.resource.data.lastAuditLogId,
            request.resource.data.status == 'inactive' ? 'patient.deactivate' : 'patient.update', 'patient', patientId);
        allow delete: if false;

        match /clinicalRecords/{recordId} {
          allow get, list: if clinicalRead(tenantId);
          allow create: if !isPremiumDemoTenant(tenantId) && clinicalWrite(tenantId)
            && patientBelongsToTenant(tenantId, patientId)
            && request.resource.data.tenantId == tenantId
            && request.resource.data.patientId == patientId
            && request.resource.data.dentistId is string
            && exists(/databases/$(database)/documents/tenants/$(tenantId)/professionals/$(request.resource.data.dentistId))
            && get(/databases/$(database)/documents/tenants/$(tenantId)/professionals/$(request.resource.data.dentistId)).data.tenantId == tenantId
            && get(/databases/$(database)/documents/tenants/$(tenantId)/professionals/$(request.resource.data.dentistId)).data.status == 'active'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.recordType in ['evolution','procedure','note']
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 12000
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['tenantId','patientId','dentistId','appointmentId','recordType','content','createdAt','createdBy','auditLogId'])
            && (!('appointmentId' in request.resource.data)
              || (exists(/databases/$(database)/documents/tenants/$(tenantId)/appointments/$(request.resource.data.appointmentId))
                && get(/databases/$(database)/documents/tenants/$(tenantId)/appointments/$(request.resource.data.appointmentId)).data.patientId == patientId
                && get(/databases/$(database)/documents/tenants/$(tenantId)/appointments/$(request.resource.data.appointmentId)).data.tenantId == tenantId))
            && auditAfterMatches(tenantId, request.resource.data.auditLogId, 'clinical_record.create', 'clinicalRecord', recordId);
          allow update, delete: if false;
        }

        match /clinicalRecordAmendments/{amendmentId} {
          allow get, list: if clinicalRead(tenantId);
          allow create: if !isPremiumDemoTenant(tenantId) && clinicalWrite(tenantId)
            && patientBelongsToTenant(tenantId, patientId)
            && request.resource.data.tenantId == tenantId
            && request.resource.data.patientId == patientId
            && request.resource.data.recordId is string
            && exists(/databases/$(database)/documents/tenants/$(tenantId)/patients/$(patientId)/clinicalRecords/$(request.resource.data.recordId))
            && get(/databases/$(database)/documents/tenants/$(tenantId)/patients/$(patientId)/clinicalRecords/$(request.resource.data.recordId)).data.tenantId == tenantId
            && get(/databases/$(database)/documents/tenants/$(tenantId)/patients/$(patientId)/clinicalRecords/$(request.resource.data.recordId)).data.patientId == patientId
            && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 500
            && request.resource.data.content is string && request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 12000
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.keys().hasOnly(['tenantId','patientId','recordId','reason','content','professionalId','createdAt','createdBy','auditLogId'])
            && auditAfterMatches(tenantId, request.resource.data.auditLogId, 'clinical_amendment.create', 'clinicalAmendment', amendmentId);
          allow update, delete: if false;
        }

      match /clinicalPhotos/{photoId} {
          allow get, list: if clinicalRead(tenantId);
          // Media is uploaded by the authenticated R2 Worker after server-side authorization.
          allow create, update, delete: if false;
        }
      }

      match /appointments/{appointmentId} {
        allow get, list: if hasPermission(tenantId, 'appointments.read');
        // A trusted worker owns create/reschedule so direct Firestore writes cannot skip conflict checks.
        allow create, update, delete: if false;
      }

      match /scheduleBlocks/{blockId} {
        allow get, list: if hasPermission(tenantId, 'appointments.read');
        allow create, update: if hasPermission(tenantId, 'appointments.manage')
          && !isPremiumDemoTenant(tenantId)
          && request.resource.data.tenantId == tenantId
          && request.resource.data.startsAt is string
          && request.resource.data.endsAt is string
          && request.resource.data.startsAt < request.resource.data.endsAt
          && request.resource.data.active is bool;
        allow delete: if false;
      }

      match /scheduleResources/{resourceId} {
        allow get, list: if hasPermission(tenantId, 'resources.read');
        allow create, update: if false;
        allow delete: if false;
      }

      match /recalls/{recallId} {
        allow get, list: if hasPermission(tenantId, 'recalls.read') && hasCommercialFeature(tenantId, 'recall_center', 'pro');
        allow create, update: if !isPremiumDemoTenant(tenantId)
          && hasPermission(tenantId, 'recalls.manage') && hasCommercialFeature(tenantId, 'recall_center', 'pro')
          && request.resource.data.tenantId == tenantId
          && request.resource.data.patientId is string
          && exists(/databases/$(database)/documents/tenants/$(tenantId)/patients/$(request.resource.data.patientId))
          && get(/databases/$(database)/documents/tenants/$(tenantId)/patients/$(request.resource.data.patientId)).data.tenantId == tenantId;
        allow delete: if false;
      }

      match /patientIntakeSubmissions/{submissionId} {
        allow get, list: if hasPermission(tenantId, 'intake.read') && resource.data.tenantId == tenantId;
        allow create: if false;
        allow update, delete: if false;
      }

      match /usageCounters/{counterId} {
        allow get, list: if isPlatformOwner() || hasPermission(tenantId, 'usage.read');
        allow create, update, delete: if false;
      }

      match /limitCounters/{counterId} {
        allow read, write: if false;
      }

      match /treatmentPlans/{planId} {
        allow get, list: if hasPermission(tenantId, 'treatment.read') || clinicalRead(tenantId);
        allow create, update, delete: if false;
      }

      match /quotes/{quoteId} {
        allow get, list: if hasPermission(tenantId, 'billing.read');
        allow create, update, delete: if false;
      }

      match /auditLogs/{auditId} {
        allow get, list: if isPlatformOwner() || hasPermission(tenantId, 'audit.read');
        allow create: if auditEnvelopeValid(tenantId, auditId, request.resource.data);
        allow update, delete: if false;
      }
    }
  }
}
